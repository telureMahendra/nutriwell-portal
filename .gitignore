# OS
.DS_Store
Thumbs.db

# Node / build
node_modules/
npm-debug.log*
yarn-error.log

# PHP / composer
vendor/
composer.lock

# Environment / secrets
.env
.env.*    # avoid environment variants being committed (env.local etc)
# app/Config/firebase-service-account.json
# app/Config/firebase-service-account*.json

# CodeIgniter and app-specific
writable/cache/*
writable/debugbar/*
writable/session/*
writable/uploads/*
writable/logs/*
# but keep writable/ permission metadata in repo if you want; otherwise manage on server

# IDEs / editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# common
*.log
*.sql
*.sqlite
coverage/
tests/_output/

# temporary files
*.swp
*.swo
*.bak

# SSH keys or other keys
*.pem
*.key

# If you produce zip or installables
dist/
build/

flutter_application/