        </div>
    </div>

    <div class="modal fade" id="postcomment" tabindex="-1" role="basic" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Comment</h4>
            </div>
            <div class="modal-body">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">Comment<span class="required" aria-required="true"> *</span></label>
                                <textarea name="comment" id="comment" title="Comment" class="form-control"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn default" id="yes">Submit</button>
                    <button type="button" class="btn default" id="no" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>


    <script type="text/javascript">
        function complete_appointment(appointment_id) {
            $('#complete_appointment').modal();
            $('#complete_appointment #yes').click(function() {
                var url = '<?= base_url('mentor/appointment/complete') ?>';
                $.post(url, {
                    appointment_id: appointment_id,
                }, function(responseText) {
                    if (responseText == 1) {
                        location.href = '<?= base_url('mentor/appointment/') ?>';
                    } else {
                        alert('Something went wrong with your request');
                    }
                });
            });
        }

        function postcomment(appointment_id) {
        $('#postcomment').modal();
        $('#postcomment #yes').click(function () {
            var comment = $('#comment').val();
            $.ajax({
                url : '<?= base_url('mentor/appointment/postcomment') ?>',
                type: 'POST',
                data: { appointment_id: appointment_id, comment: comment },
                success: function(response){
                    if (response == 1) {
                        location.reload(true);
                    } else {
                        alert('Something went wrong with your request');
                    }
                }
            });
        });
    }        
    </script>
    <?= $this->endSection(); ?>