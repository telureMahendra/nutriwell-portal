<?php
$db = db_connect();


$salesAgent = 0;
$sqlA = "SELECT count(*) as totalSalesAgent from users WHERE user_role='SalesAgent'";
$queryA = $db->query($sqlA);
$resultA = $queryA->getRowArray();
if ($resultA) {
    $salesAgent = $resultA["totalSalesAgent"];
}

$salesAmount = 0;
$sqlB = "SELECT sum(total_amount) as salesAmount from booking WHERE status='Active'";
$queryB = $db->query($sqlB);
$resultB = $queryB->getRowArray();
if ($resultB) {
    $salesAmount = $resultB["salesAmount"];
}

$totalClients = 0;
$sqlC = "SELECT count(*) as totalClients from client_profile WHERE status='Active'";
$queryC = $db->query($sqlC);
$resultC = $queryC->getRowArray();
if ($resultC) {
    $totalClients = $resultC["totalClients"];
}


$totalMentors = 0;
$sqlD = "SELECT count(*) as totalMentors from doctor WHERE status='Active'";
$queryD = $db->query($sqlD);
$resultD = $queryD->getRowArray();
if ($resultD) {
    $totalMentors = $resultD["totalMentors"];
}



$sqlE = "
SELECT 
	appointment.appointment_id,appointment.date,appointment.slot,
	client_profile.client_name,
	plan.name as planName,
	doctor.doctor_name
FROM 
	appointment 
INNER JOIN
	client_profile ON appointment.client_id=client_profile.client_id
INNER JOIN
	booking ON appointment.booking_id=booking.booking_id
INNER JOIN
	plan ON booking.plan_id=plan.plan_id
INNER JOIN
	doctor ON appointment.doctor_id=doctor.doctor_id

WHERE 
	appointment.date='" . date('Y-m-d') . "'
";
$queryE = $db->query($sqlE);
$resultE = $queryE->getResultArray();




$sqlF = "
SELECT 
	booking.booking_id,booking.date,booking.total_amount,
	client_profile.client_name,
	plan.name as planName
FROM 
	booking 
INNER JOIN
	client_profile ON booking.client_id=client_profile.client_id
INNER JOIN
	plan ON booking.plan_id=plan.plan_id
WHERE 
	booking.status='Active' AND 
	booking.date='" . date('Y-m-d') . "'
";
$queryF = $db->query($sqlF);
$resultF = $queryF->getResultArray();



$sqlG = "
SELECT 
	booking.plan_id,sum(booking.total_amount) as totalAmount,
	plan.name as planName,
    plan.category as planCategory,
    plan.validaty
FROM 
	booking 
INNER JOIN
	client_profile ON booking.client_id=client_profile.client_id
INNER JOIN
	plan ON booking.plan_id=plan.plan_id
WHERE 
	booking.status='Active' 

GROUP BY
	booking.plan_id
";
$pieArray = [];
$queryG = $db->query($sqlG);
$resultG = $queryG->getResultArray();
foreach ($resultG as $row) {
    $pieArray[] =  array("country" => $row["planName"]. ' - ' . $row["planCategory"] , "value" => $row["totalAmount"]);
}

$sqlH = "SELECT 
	YEAR(date) AS appointment_year, 
    MONTH(date) AS appointment_month, 
        MONTHNAME(date) AS month_name,
    COUNT(*) AS appointment_count 
FROM 
	appointment GROUP BY YEAR(date), 
    MONTH(date) 
ORDER BY 
    MONTH(date) ASC 
Limit 6";
$barArray = [];
$queryH = $db->query($sqlH);
$resultH = $queryH->getResultArray();
foreach ($resultH as $row) {
    $barArray[] =  array("country" => $row["month_name"].' - '.$row["appointment_year"], "visits" => $row["appointment_count"], "color" => "#" . substr(md5(rand()), 0, 6));
}


?>
