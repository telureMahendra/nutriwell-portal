    // view plans list that i have book/ subscribed
    public function subscription()
    {
        $this->headers();
        $this->_request = file_get_contents("php://input");
        $this->_request = implode("", explode("\\", $this->_request));

        $json_data = $this->request->getJSON();
        $tocken = trim($json_data->tocken);

        if (!empty($tocken)) {
            $check_login = $this->client_login_model->checkTocken($tocken);
            if (!empty($check_login)) {
                $bookingList = $this->plans_model->getBookingList($check_login[0]->client_id);
                if (!empty($bookingList)) {

                    foreach ($bookingList as $key => $value) {
                        $bookingList[$key]->background_img_url = base_url() . "public/uploads/plan/background";
                        $bookingList[$key]->header_img_url = base_url() . "public/uploads/plan/header";
                    }

                    $response = ['status' => true, 'msg' => 'Get Plan Details Successfully', 'data' => $bookingList];
                } else {
                    $response = ['status' => false, 'msg' => 'Plan Not Found', 'data' => $bookingList];
                }
            } else {
                $response = ['status' => false, 'msg' => 'User Not Login'];
            }
        } else {
            $response = ['status' => false, 'msg' => 'Enter Valid Data'];
        }
        return $this->response->setJSON($response);
    }
}
